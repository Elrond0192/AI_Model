# Basketball Performance AI – environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ---------------------------------------------------------------------------
# Azure SQL Server connection
# ---------------------------------------------------------------------------
# Full ODBC connection string for Azure SQL Server.
# Example:
#   mssql+pyodbc://username:password@server.database.windows.net/dbname
#   ?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
#
# Alternatively you can provide the individual components below and the loader
# will assemble the connection string automatically.
AZURE_SQL_CONNECTION_STRING=

# Individual components (used only when AZURE_SQL_CONNECTION_STRING is empty)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=basketball_ai
AZURE_SQL_USERNAME=your_username
AZURE_SQL_PASSWORD=your_password
# ODBC driver installed on the server/container
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# ---------------------------------------------------------------------------
# API security
# ---------------------------------------------------------------------------
# Shared secret sent in the X-API-Key header for protected endpoints.
# Leave empty to disable API-key authentication (development only).
API_KEY=

# ---------------------------------------------------------------------------
# Data / model paths (override defaults when running outside the repo root)
# ---------------------------------------------------------------------------
DATA_DIR=data/sample
MODEL_DIR=models_saved
