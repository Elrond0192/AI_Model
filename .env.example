# AI_Model production environment
# Copy to .env. Never commit real secrets.

# PostgreSQL runs on the Docker host. Prefer a runtime DB profile created from
# the admin console; DATABASE_URL is only for secret-injected deployments.
DATABASE_PROFILE=production
DATABASE_PROFILES_FILE=/app/config/database_profiles.json
DATABASE_URL=
POSTGRES_SOURCE_SCHEMA=AI_Source
DATA_SOURCE=postgres
AI_SCHEMA=AI
POSTGRES_CONNECT_TIMEOUT=10
# Set to serving only after ai_scenario_serving.sql has been installed and
# training/scenario contexts have been backfilled by the ETL.
POSTGRES_TRAINING_SOURCE=canonical
SCENARIO_FEED_CACHE_TTL_SECONDS=300
TRAINING_SNAPSHOT_DIR=/app/models_saved/snapshots

# API v2 service authentication. Use API_KEY for WordPress server-to-server,
# or JWT_SECRET/JWT_SECRETS for externally provisioned bearer tokens.
API_ENV=production
API_KEY=
JWT_SECRET=
JWT_SECRETS=
JWT_ALGORITHM=HS256
ALLOWED_ORIGINS=https://your-wordpress-host.example

# Persistent immutable model/admin runtime. The API Docker service overrides
# MODEL_DIR to /app/models_saved/production and therefore never loads candidate runs.
MODEL_DIR=/app/models_saved
MODEL_VERSION=2.2.0
SESSION_SECRET_KEY=
SESSION_COOKIE_TTL_DAYS=7

# Custom admin web console. The service is bound to 127.0.0.1:8501 by Compose
# and should be published only through the secured Nginx virtual host.
ADMIN_COOKIE_SECURE=true
ADMIN_API_BASE_URL=http://api:8000

# Out-of-time model promotion gates. Tune these only after reviewing real
# validation volume; never loosen a gate merely to make a candidate pass.
MODEL_PROMOTION_THRESHOLD_PCT=2.0
MODEL_MAX_SEGMENT_REGRESSION_PCT=15.0
MODEL_MIN_BACKTEST_SAMPLES=20
MODEL_MIN_COMPETITION_BACKTEST_SAMPLES=10
MODEL_MIN_COMPETITION_CALIBRATION_SAMPLES=10
MODEL_TARGET_INTERVAL_COVERAGE=0.90
MODEL_INTERVAL_COVERAGE_TOLERANCE=0.10
BACKTEST_MIN_SAMPLES_PER_FOLD=10

# Observability.
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_REQUEST_BODY_MB=10

# Optional display-name policy: CC:name or CC:short_name.
TEAM_DISPLAY_FIELD_MAP=
