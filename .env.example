# Basketball Performance AI – environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ---------------------------------------------------------------------------
# PostgreSQL connection
# ---------------------------------------------------------------------------
# PostgreSQL runs on the host.  On Linux Docker, host.docker.internal must be
# mapped through host-gateway (already done in docker-compose.yml).
DATABASE_URL=postgresql+psycopg://hoopmetrics_ai:CHANGE_ME@host.docker.internal:5432/hoopmetrics
DATA_SOURCE=postgres
AI_SCHEMA=ai

# ---------------------------------------------------------------------------
# API security
# ---------------------------------------------------------------------------
# Shared secret sent in the X-API-Key header for protected endpoints.
# Leave empty to disable API-key authentication (development only).
API_KEY=

# ---------------------------------------------------------------------------
# JWT authentication (primary auth method)
# ---------------------------------------------------------------------------
# HMAC-SHA256 signing secret.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Algorithm (default: HS256).
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 30).
JWT_ACCESS_EXPIRE=30

# Refresh token lifetime in hours (default: 24).
JWT_REFRESH_EXPIRE=24

# Simple user map for standalone / CI deployments.
# Format: JSON object {"username": "password", ...}
# When empty, the auth.py users.json store is used instead (Streamlit admin panel).
JWT_USERS=

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Tenant identifier embedded in every JWT token issued by this deployment.
# Used by API consumers to scope data access without additional lookups.
# In a single-tenant self-hosted setup leave this as "default".
# In a SaaS hosted setup set a unique slug per customer environment
# (e.g. "acme-sports", "nba-analytics").
JWT_TENANT_ID=default

# ---------------------------------------------------------------------------
# Data / model paths (override defaults when running outside the repo root)
# ---------------------------------------------------------------------------
DATA_DIR=data/sample
MODEL_DIR=models_saved

# ---------------------------------------------------------------------------
# Team display-name mapping (optional)
# ---------------------------------------------------------------------------
# Controls which DB field is used as the displayed team name, per country.
# Format: comma-separated CC:field pairs where CC is an ISO 3166-1 alpha-2
# country code and field is either "name" (full TeamName) or "short_name"
# (abbreviated ShortName).
#
# Example: show full names for Italian and Greek teams, abbreviations for Spanish
#   TEAM_DISPLAY_FIELD_MAP=IT:name,GR:name,ES:short_name
#
# When a country is not listed the default behaviour applies: use short_name
# when non-empty, otherwise fall back to name.
TEAM_DISPLAY_FIELD_MAP=

# ---------------------------------------------------------------------------
# Session / authentication
# ---------------------------------------------------------------------------
# Secret key used to derive session tokens.  Generate a strong random value
# with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production – leaving it empty causes a new random key to be
# generated on every restart, which invalidates all browser sessions.
SESSION_SECRET_KEY=

# How many days a "remember me" cookie stays valid (default: 7).
SESSION_COOKIE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# S6 – Cookie security flags
# ---------------------------------------------------------------------------
# Set to true in production to enforce Secure cookie flag via Streamlit.
# Also enforce HttpOnly and SameSite=Lax via a reverse proxy (nginx/caddy).
STREAMLIT_SERVER_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Branding (embed / white-label)
# ---------------------------------------------------------------------------
# These variables customise the lightweight embed page (gui/embed.py) that
# can be iframed into a customer's website or admin portal.
# They have no effect on the full Streamlit admin panel (gui/app.py).

# Title shown in the chat widget header.
BRAND_TITLE=Basketball Performance AI

# Primary accent colour (CSS hex).
BRAND_PRIMARY_COLOR=#1565C0

# Optional URL of a logo image (PNG/SVG). Leave empty to show no logo.
BRAND_LOGO_URL=

# Base URL of the FastAPI server the embed widget talks to.
# e.g. https://basketball-ai.example.com
BRAND_API_URL=http://localhost:8000

# Optional message displayed below the chat input as a disclaimer / tagline.
BRAND_FOOTER_TEXT=
